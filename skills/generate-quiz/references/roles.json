            ["answer_target"],
            ["user_conditions", "sources", "propositions", "clues", "competitors", "asked_knowledge", "terms", "answers", "generation_checks", "final_input", "difficulty_review", "terminology_review", "blind_candidates", "answer_review", "evidence_challenge"]
